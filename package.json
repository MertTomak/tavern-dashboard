{
  "name": "hearthstone-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev",
    "prewatch:logs": "node scripts/check-node.mjs",
    "watch:logs": "tsx scripts/watch-logs.ts",
    "predev:all": "node scripts/check-node.mjs",
    "dev:all": "concurrently -n web,logs -c yellow,cyan \"npm:dev\" \"npm:watch:logs\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:unseed": "tsx scripts/unseed.ts",
    "cards:sync": "tsx scripts/sync-cards.ts",
    "art:sync": "tsx scripts/sync-art.ts",
    "app:bundle": "tsx scripts/build-electron.ts",
    "preapp:dev": "node scripts/check-node.mjs",
    "app:dev": "npm run app:bundle && concurrently -k -n web,app -c yellow,magenta \"npm:dev\" \"TAVERN_DEV_URL=http://localhost:3000 electron .\"",
    "preapp:build": "node scripts/check-node.mjs",
    "app:build": "tsx scripts/app-build.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-sqlite3": "^13.1.1",
    "chokidar": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "deckstrings": "^3.1.2",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "local.tavern-dashboard",
    "productName": "Tavern Dashboard",
    "copyright": "Personal, non-commercial fan tool",
    "directories": {
      "output": "dist-app/release",
      "buildResources": "assets/app-icon"
    },
    "files": [
      "package.json",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-app/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/app-icon",
        "to": ".",
        "filter": [
          "trayTemplate*.png"
        ]
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "target": "dir",
      "icon": "assets/app-icon/icon.icns",
      "category": "public.app-category.games",
      "identity": null,
      "darkModeSupport": true
    }
  }
}
